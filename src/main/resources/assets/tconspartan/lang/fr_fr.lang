# Armes
item.tconspartan.dagger.name=Dague
item.tconspartan.dagger.desc=Une lame courte et vive, trois fois plus mortelle dans le dos.\nMaintenez clic droit pour la lancer.
item.tconspartan.parrying_dagger.name=Dague de parade
item.tconspartan.parrying_dagger.desc=Une lame de seconde main faite pour détourner les coups.\nMaintenez clic droit pour parer les attaques de mêlée.
item.tconspartan.katana.name=Katana
item.tconspartan.katana.desc=Un sabre courbe et vif, qui balaie les foules et mord profondément les ennemis sans armure.\nÀ manier à deux mains.
item.tconspartan.saber.name=Sabre
item.tconspartan.saber.desc=Une épée de cavalerie à la frappe balayante.\nLa tenir absorbe une partie des dégâts de mêlée reçus.
item.tconspartan.spear.name=Lance
item.tconspartan.spear.desc=Une arme d'hast simple et fiable, qui tient les ennemis à distance.
item.tconspartan.mace.name=Masse à ailettes
item.tconspartan.mace.desc=Une masse à ailettes qui brise les os.\nParticulièrement efficace contre les morts-vivants.
item.tconspartan.quarterstaff.name=Bâton de combat
item.tconspartan.quarterstaff.desc=Un bâton rapide à deux mains qui balaie autour de vous.\nLe matériau de la tête coiffe le haut, celui de l'attache le bas.
item.tconspartan.throwing_knife.name=Couteau de lancer
item.tconspartan.throwing_knife.desc=Une pile de couteaux équilibrés : leur nombre dépend des matériaux.\nMaintenez clic droit puis relâchez pour en lancer un.
item.tconspartan.throwing_axe.name=Hache de lancer
item.tconspartan.throwing_axe.desc=Une pile de lourdes haches de lancer : leur nombre dépend des matériaux.\nMaintenez clic droit puis relâchez pour en lancer une.
item.tconspartan.javelin.name=Javelot
item.tconspartan.javelin.desc=Un lot de javelots aux lourds dégâts en lancer.\nMaintenez clic droit puis relâchez pour en lancer un.
item.tconspartan.caestus.name=Caestus
item.tconspartan.caestus.desc=Un gant de combat clouté pour une pluie de coups rapides.\nLes ennemis n'ont presque pas de répit entre deux coups.
item.tconspartan.boomerang.name=Boomerang
item.tconspartan.boomerang.desc=Maintenez clic droit puis relâchez pour le lancer :\nil vous revient après avoir touché quelque chose.
item.tconspartan.pike.name=Pique
item.tconspartan.pike.desc=Une très longue lance tenue à deux mains.\nFrappe de plus loin que toute autre arme.
item.tconspartan.lance.name=Lance de joute
item.tconspartan.lance.desc=Une arme de chevalier à la portée étendue.\nInflige le double de dégâts à cheval.
item.tconspartan.glaive.name=Glaive
item.tconspartan.glaive.desc=Une arme d'hast tranchante à la portée étendue.\nSon balayage inflige la moitié des dégâts autour de la cible.
item.tconspartan.greatsword.name=Espadon
item.tconspartan.greatsword.desc=Une énorme épée à deux mains.\nSon balayage inflige tous les dégâts autour de la cible.
item.tconspartan.halberd.name=Hallebarde
item.tconspartan.halberd.desc=Une lourde arme d'hast à la portée étendue.\nSes coups désactivent les boucliers.
item.tconspartan.battle_axe.name=Hache de bataille
item.tconspartan.battle_axe.desc=Une lourde hache à double tranchant.\nUne arme avant tout, mais elle coupe aussi le bois.
item.tconspartan.warhammer.name=Marteau de guerre
item.tconspartan.warhammer.desc=Sa pointe perce les plaques.\nLa moitié des dégâts ignore l'armure.
item.tconspartan.battle_hammer.name=Marteau de bataille
item.tconspartan.battle_hammer.desc=Un marteau lent et écrasant.\nRepousse les ennemis et les laisse étourdis.
item.tconspartan.war_scythe.name=Faux de guerre
item.tconspartan.war_scythe.desc=Une arme de moisson au large balayage.\nFrappe plus fort les ennemis sans casque.

