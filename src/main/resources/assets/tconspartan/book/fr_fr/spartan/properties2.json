{
  "title": "Propriétés (2)",
  "text": [
    {
      "text": "Dégâts bonus",
      "color": "dark_blue"
    },
    {
      "text": " : dégâts en plus dans certains cas : dans le dos, contre les morts-vivants, à cheval, ou contre les ennemis sans plastron ou sans casque."
    },
    {
      "text": "\n"
    },
    {
      "text": "Absorption",
      "color": "dark_blue"
    },
    {
      "text": " : tenue en main, réduit les dégâts de mêlée reçus."
    },
    {
      "text": "\n"
    },
    {
      "text": "Parade",
      "color": "dark_blue"
    },
    {
      "text": " : maintenez clic droit pour détourner les attaques de mêlée."
    },
    {
      "text": "\n"
    },
    {
      "text": "Polyvalente",
      "color": "dark_blue"
    },
    {
      "text": " : sert aussi de hache."
    },
    {
      "text": "\n"
    },
    {
      "text": "\n"
    },
    {
      "text": "Maintenez "
    },
    {
      "text": "Maj",
      "color": "dark_blue"
    },
    {
      "text": " sur une arme pour lire le détail de ses propriétés."
    }
  ]
}
